        </mxCell>
        <mxCell id="flow-description-1" value="1️⃣ Exchange generates market data → 2️⃣ Collector ingests via WebSocket → 3️⃣ Raw data to Kafka → 4️⃣ Normaliser processes → 5️⃣ Normalized data to Kafka → 6️⃣ Bridge forwards to RabbitMQ → 7️⃣ Gateway broadcasts via SignalR → 8️⃣ WebUI displays real-time chart" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#f57f17;" vertex="1" parent="1">
